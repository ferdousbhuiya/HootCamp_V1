# ============================================================
# Skills Pathfinder — Self-Hosted Supabase environment (template)
# Copy to `supabase/.env` on the server and fill in real values.
# NEVER commit this file with real values.
#
# Two paths:
#   A) Coolify "Supabase" template  -> it wires most of these for you.
#      You still must supply JWT secret + SMTP (below).
#   B) Standalone `docker compose up` -> see docker-compose.supabase.yml.
# ============================================================

# --- Postgres ---
# Strong random password:  openssl rand -base64 24 | tr -d '/+=' | head -c 32
POSTGRES_PASSWORD=replace_me

# --- Auth (GoTrue) ---
# JWT secret:  openssl rand -base64 64 | tr -d '/+=' | head -c 32
JWT_SECRET=replace_me
JWT_EXPIRY=3600

# The app's public origin — used in confirmation links and redirects.
SITE_URL=https://ferdouse.us
ADDITIONAL_REDIRECT_URLS=https://ferdouse.us,http://localhost:5173

# --- JWT / API keys (generated from JWT_SECRET) ---
# Generate the two keys matching the JWT secret at:
#   https://supabase.com/docs/guides/getting-started/quickstarts/with-curl#get-the-api-keys
# or with the script in this repo's deploy docs. anon = browser-safe, service_role = server only.
ANON_KEY=replace_me
SERVICE_ROLE_KEY=replace_me
# Keys in supabase-js anon format are: eyJhbGciOi...<JWT_SECRET-as-JWT>... (see docs)

# --- SMTP (required for email verification / password reset) ---
# Example using Gmail App Password:
SMTP_ADMIN_EMAIL=noreply@ferdouse.us
SMTP_USER=replace_me
SMTP_PASS=replace_me
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_NAME=Skills Pathfinder
# Alternative providers: smtp-relay.brevo.com / smtp.resend.com / smtp.sendgrid.net

# --- Storage / S3 (certificate images) ---
# Optional until certificate file storage is used.
STORAGE_BUCKET=certificates