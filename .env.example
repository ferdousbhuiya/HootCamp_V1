# ============================================================
# Skills Pathfinder — cross-app environment template
# Copy to the right location on your server / Coolify and fill values.
# NEVER commit real secrets. Keep this file as placeholders only.
# ============================================================

# ---------- Backend (set in Coolify resource: skills-pathfinder-backend) ----------
# Groq LLM key (create at console.groq.com)
GROQ_API_KEY=replace_me
# llama-3.3-70b-versatile unless you prefer another
GROQ_MODEL=llama-3.3-70b-versatile

# Self-hosted Supabase (the values generated in supabase/.env)
SUPABASE_URL=replace_me              # e.g. http://kong:8000 or http://<vps-ip>:54321 — internal endpoint GoTrue/PostgREST expose
SUPABASE_KEY=replace_me              # SERVICE_ROLE_KEY (server only, DO NOT expose to browser)

# CORS: comma-separated browser origins allowed to call the API directly
ALLOWED_ORIGINS=https://ferdouse.us,https://www.ferdouse.us,http://localhost:5173

# Optional Windows dev-only path; container defaults to "tesseract" on PATH
TESSERACT_CMD=tesseract

# ---------- Frontend (set as build args on Coolify resource: Skills-Pathfinder-frontend) ----------
# Topology B (recommended, same-origin): leave VITE_API_URL EMPTY/blank so nginx
# proxies /api/* internally. Topology A alternative: set to https://api.ferdouse.us
VITE_API_URL=

# Client-safe Supabase values (anon key is public by design; RLS protects data)
VITE_SUPABASE_URL=replace_me         # e.g. https://supabase.ferdouse.us (public) or http://kong:8000 (proxied)
VITE_SUPABASE_ANON_KEY=replace_me    # anon key (NOT service_role)